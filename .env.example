# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project URL (Project Settings > API > Project URL).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_SERVICE_ROLE_KEY: Server-only secret key (Project Settings > API > service_role key).
# NEVER expose this in client-side code — it bypasses Row Level Security. Server use only.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
